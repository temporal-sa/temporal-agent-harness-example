# Never bake secrets or local state into the image.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Virtualenvs / caches
.venv
**/node_modules/
**/__pycache__/
*.py[cod]

# Local runtime data (sqlite, claim-check store, replay)
.simple_chat_agent/
.replay/

# The web app is built inside the image; never copy a local build or test output.
simple_chat_agent/web/dist/
simple_chat_agent/web/e2e/.results*/
simple_chat_agent/web/e2e/.report/
**/test-results/

# VCS / IDE / OS
.git
.gitignore
.zed/
.vscode/
.idea/
.DS_Store
**/.DS_Store

# Infra-as-code and Terraform local state / provider downloads (not needed at runtime)
infra/
**/.terraform/
**/*.tfstate*

# Deploy artifacts and docs not needed at runtime
deploy/
**/deploy/
Dockerfile
**/Dockerfile
*.md
!README.md

# Local-only output that must never reach an image (P5 review).
.lambda-build/
dev.db*
simple_chat_agent/web/e2e/.demo-runs/
simple_chat_agent/web/e2e/__screenshots__/
simple_chat_agent/web/e2e/.results*/
.pytest_cache/
.ruff_cache/
