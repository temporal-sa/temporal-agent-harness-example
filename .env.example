ANTHROPIC_API_KEY=
# Optional. Point Anthropic SDK calls at a compatible gateway such as LiteLLM.
ANTHROPIC_BASE_URL=
SIMPLE_CHAT_JWT_SECRET=
# Catalog mode is the deployed default. These settings opt into local login.
SIMPLE_CHAT_AUTH_MODE=local
SIMPLE_CHAT_LOCAL_AUTH_ENABLED=1
SIMPLE_CHAT_LOCAL_AUTH_USERNAME=demo
SIMPLE_CHAT_LOCAL_AUTH_PASSWORD=demo
# When fronted by a reverse proxy on a different host, list the proxy IPs
# (comma-separated) so uvicorn honors X-Forwarded-Proto/Host. Use "*" to trust all.
FORWARDED_ALLOW_IPS=127.0.0.1
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user,user:email,public_repo,repo
# Optional web search through Gemini with Google Search grounding. When set,
# this replaces SearXNG as the search_web backend.
GOOGLE_SEARCH_GROUNDING_API_KEY=
GOOGLE_SEARCH_GROUNDING_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY enables the other Google-backed research tools when their APIs
# are enabled in the Google Cloud project. For local SearXNG Docker setup, see
# docs/local-development.md.
GOOGLE_API_KEY=
SIMPLE_CHAT_SEARXNG_BASE_URL=
TEMPORAL_API_KEY=
TEMPORAL_NAMESPACE=
TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_ENDPOINT remains supported for older local configurations.
TEMPORAL_ENDPOINT=
TEMPORAL_TLS=
# The catalog owns task queues and deployment/build identities.
# Local development uses these defaults.
SIMPLE_CHAT_TASK_QUEUE=simple-chat-agent
SIMPLE_CHAT_WORKER_VERSION=1.0.0
# On SIGTERM, stop polling and let in-flight Activities finish for up to this
# many seconds. Kubernetes must allow a slightly longer pod termination window.
SIMPLE_CHAT_WORKER_GRACEFUL_SHUTDOWN_SECONDS=1200
# Disable worker versioning for local/dev defaults. Shared deployments should
# leave versioning enabled unless they intentionally opt out.
SIMPLE_CHAT_WORKER_VERSIONING_ENABLED=0
SIMPLE_CHAT_WORKFLOW_PREFIX=
# The Good Place censor: rewrite swears into wholesome substitutes inside the
# LLM guards (default on). Set to 0 to disable.
SIMPLE_CHAT_GOOD_PLACE=1
# Optional Redis Streams backplane. Leave unset for the local JSONL fallback.
# SIMPLE_CHAT_REDIS_URL=redis://127.0.0.1:6379/0
# SIMPLE_CHAT_REDIS_STREAM_TTL_SECONDS=1800
