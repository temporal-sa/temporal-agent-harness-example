{
  "name": "coding-agent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The coding agent's product view, served by the API at /.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "gen": "node scripts/gen.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@temporalio/agent-harness-client": "0.1.0",
    "@temporalio/agent-harness-react": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "json-schema-to-typescript": "15.0.4",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
