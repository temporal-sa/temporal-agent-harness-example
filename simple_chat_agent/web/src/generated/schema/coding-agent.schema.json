{
  "agent": "CodingAgent",
  "source": "simple_chat_agent.agent.workflow:CodingAgent",
  "init_data": {
    "data": {
      "$ref": "#/$defs/CodingAgentInit"
    },
    "required": true
  },
  "handlers": {
    "chat": {
      "description": "Ask the coding agent to do something in its workspace, or ask it a question.",
      "mid_turn": "enqueue",
      "input": {
        "$ref": "#/$defs/ChatMessage"
      },
      "output": {
        "$ref": "#/$defs/ChatReply"
      }
    },
    "forget_always_allowed": {
      "description": "Forget this session's \"always allow\" approvals. Those tools ask again unless the posture allows them.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/ForgetAlwaysAllowed"
      },
      "output": {
        "$ref": "#/$defs/AlwaysAllowedForgotten"
      }
    },
    "interrupt": {
      "description": "Stop the turn in progress. Pending approvals in it are declined.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/InterruptRequest"
      },
      "output": {
        "$ref": "#/$defs/Ack"
      }
    },
    "set_model": {
      "description": "Switch the provider and/or model. Takes effect from the next turn.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/SetModel"
      },
      "output": {
        "$ref": "#/$defs/SettingsAck"
      }
    },
    "set_posture": {
      "description": "Change how tool calls are approved. Applies to new calls; pending ones stay with you.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/SetPosture"
      },
      "output": {
        "$ref": "#/$defs/SettingsAck"
      }
    },
    "set_web_search": {
      "description": "Turn the model provider's built-in web search on or off. Applies from the next turn.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/SetWebSearch"
      },
      "output": {
        "$ref": "#/$defs/SettingsAck"
      }
    },
    "steer": {
      "description": "Guide the turn in progress. The text reaches the agent before its next model call.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/SteerMessage"
      },
      "output": {
        "$ref": "#/$defs/Ack"
      }
    }
  },
  "states": {
    "plan": {
      "$ref": "#/$defs/PlanState"
    },
    "changes": {
      "$ref": "#/$defs/ChangesState"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceState"
    }
  },
  "$defs": {
    "Ack": {
      "description": "Acknowledgement for control operations.",
      "properties": {
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "detail"
      ],
      "title": "Ack",
      "type": "object"
    },
    "AlwaysAllowedForgotten": {
      "description": "The tools that were always allowed and now ask again (as the posture says).",
      "properties": {
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "forgotten": {
          "items": {
            "type": "string"
          },
          "title": "Forgotten",
          "type": "array"
        }
      },
      "required": [
        "ok",
        "detail",
        "forgotten"
      ],
      "title": "AlwaysAllowedForgotten",
      "type": "object"
    },
    "CarriedState": {
      "description": "Everything a run hands to the next one when it continues as new.\n\nThe conversation is opaque JSON here so this module stays free of Pydantic AI; the\nworkflow validates it on the way in.",
      "properties": {
        "state_version": {
          "default": 1,
          "title": "State Version",
          "type": "integer"
        },
        "conversation": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Conversation",
          "type": "array"
        },
        "stream_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowStreamState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn_counter": {
          "default": 0,
          "title": "Turn Counter",
          "type": "integer"
        },
        "stream_acked": {
          "default": 0,
          "title": "Stream Acked",
          "type": "integer"
        },
        "recent_request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Recent Request Ids",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelChoice-Input"
        },
        "pending_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelChoice-Input"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observable": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Observable",
          "type": "object"
        },
        "steer_queue": {
          "items": {
            "type": "string"
          },
          "title": "Steer Queue",
          "type": "array"
        },
        "pending_messages": {
          "items": {
            "$ref": "#/$defs/FrontDoorMessage"
          },
          "title": "Pending Messages",
          "type": "array"
        }
      },
      "title": "CarriedState",
      "type": "object"
    },
    "ChangedFile": {
      "additionalProperties": false,
      "description": "A file the agent changed in its workspace this session.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "default": "modified",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed"
          ],
          "title": "Status",
          "type": "string"
        },
        "added": {
          "default": 0,
          "title": "Added",
          "type": "integer"
        },
        "removed": {
          "default": 0,
          "title": "Removed",
          "type": "integer"
        },
        "tool_id": {
          "default": "",
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "status",
        "added",
        "removed",
        "tool_id"
      ],
      "title": "ChangedFile",
      "type": "object"
    },
    "ChangesState": {
      "additionalProperties": false,
      "description": "Files changed and commits made, newest last.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/ChangedFile"
          },
          "title": "Files",
          "type": "array"
        },
        "commits": {
          "items": {
            "$ref": "#/$defs/Commit"
          },
          "title": "Commits",
          "type": "array"
        }
      },
      "required": [
        "files",
        "commits"
      ],
      "title": "ChangesState",
      "type": "object"
    },
    "ChatAttachment": {
      "description": "A file the user attached to a chat message (uploaded first with\n``POST /api/agent/sessions/{id}/attachments``, which returns its id).",
      "properties": {
        "attachment_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Attachment Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "content_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        }
      },
      "required": [
        "attachment_id"
      ],
      "title": "ChatAttachment",
      "type": "object"
    },
    "ChatMessage": {
      "description": "A user message to the coding agent.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/ChatAttachment"
          },
          "maxItems": 20,
          "title": "Attachments",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "ChatReply": {
      "description": "The agent's final answer for a turn.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/WebSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "text",
        "sources",
        "interrupted",
        "checkpoint",
        "error"
      ],
      "title": "ChatReply",
      "type": "object"
    },
    "CodingAgentInit": {
      "description": "The agent's init data: what a session starts with, plus anything carried across runs.",
      "properties": {
        "owner_id": {
          "default": "",
          "title": "Owner Id",
          "type": "string"
        },
        "session_id": {
          "default": "",
          "title": "Session Id",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelChoice-Input"
        },
        "posture": {
          "default": "trust_safe",
          "enum": [
            "ask_everything",
            "trust_safe",
            "auto",
            "never_ask"
          ],
          "title": "Posture",
          "type": "string"
        },
        "environment": {
          "default": "catalog",
          "enum": [
            "catalog",
            "local"
          ],
          "title": "Environment",
          "type": "string"
        },
        "judge": {
          "default": "llm",
          "enum": [
            "llm",
            "jev"
          ],
          "title": "Judge",
          "type": "string"
        },
        "research_tools": {
          "items": {
            "type": "string"
          },
          "title": "Research Tools",
          "type": "array"
        },
        "workspace_id": {
          "default": "",
          "title": "Workspace Id",
          "type": "string"
        },
        "depth": {
          "default": 0,
          "title": "Depth",
          "type": "integer"
        },
        "mcp": {
          "default": false,
          "title": "Mcp",
          "type": "boolean"
        },
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt"
        },
        "carried": {
          "anyOf": [
            {
              "$ref": "#/$defs/CarriedState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "web_search_allowed": {
          "default": false,
          "title": "Web Search Allowed",
          "type": "boolean"
        },
        "web_search": {
          "default": false,
          "title": "Web Search",
          "type": "boolean"
        },
        "force_continue_as_new_after_turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Force Continue As New After Turns"
        },
        "test_tools": {
          "default": false,
          "title": "Test Tools",
          "type": "boolean"
        },
        "test_history_event_cap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test History Event Cap"
        }
      },
      "title": "CodingAgentInit",
      "type": "object"
    },
    "Commit": {
      "additionalProperties": false,
      "description": "A local commit the agent made.",
      "properties": {
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "hash",
        "message"
      ],
      "title": "Commit",
      "type": "object"
    },
    "ForgetAlwaysAllowed": {
      "description": "Forget the \"always allow\" approvals given in this session (no fields).",
      "properties": {},
      "title": "ForgetAlwaysAllowed",
      "type": "object"
    },
    "FrontDoorMessage": {
      "description": "Payload of the enqueue_message signal.",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "type"
      ],
      "title": "FrontDoorMessage",
      "type": "object"
    },
    "InterruptRequest": {
      "description": "Stop the current turn. Pending approvals in the turn are declined.",
      "properties": {
        "reason": {
          "default": "Stopped by the user.",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "InterruptRequest",
      "type": "object"
    },
    "ModelChoice-Input": {
      "description": "A provider plus a model id from that provider's allowlist.",
      "properties": {
        "provider": {
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "google"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "default": "claude-sonnet-5-5",
          "title": "Model",
          "type": "string"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "title": "ModelChoice",
      "type": "object"
    },
    "ModelChoice-Output": {
      "description": "A provider plus a model id from that provider's allowlist.",
      "properties": {
        "provider": {
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "google"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "default": "claude-sonnet-5-5",
          "title": "Model",
          "type": "string"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "required": [
        "provider",
        "model",
        "effort"
      ],
      "title": "ModelChoice",
      "type": "object"
    },
    "PlanItem": {
      "additionalProperties": false,
      "description": "One step of the agent's plan.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "in_progress",
            "done",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "text",
        "status"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "PlanState": {
      "additionalProperties": false,
      "description": "The agent's checklist for the current task.",
      "properties": {
        "goal": {
          "default": "",
          "title": "Goal",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "items"
      ],
      "title": "PlanState",
      "type": "object"
    },
    "PublisherState": {
      "description": "Per-publisher dedup state.\n\n.. warning::\n    This class is experimental and may change in future versions.\n\nTracks the last accepted ``sequence`` and the ``workflow.now()`` at\nwhich it was accepted, used together for at-least-once dedup and\nTTL-based pruning at continue-as-new time.",
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "last_seen"
      ],
      "title": "PublisherState",
      "type": "object"
    },
    "SetModel": {
      "description": "Switch provider and/or model. Applies from the next turn.",
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelChoice-Input"
        }
      },
      "required": [
        "model"
      ],
      "title": "SetModel",
      "type": "object"
    },
    "SetPosture": {
      "description": "Change how tool calls are approved. Applies to new calls; pending ones stay with you.",
      "properties": {
        "posture": {
          "enum": [
            "ask_everything",
            "trust_safe",
            "auto",
            "never_ask"
          ],
          "title": "Posture",
          "type": "string"
        }
      },
      "required": [
        "posture"
      ],
      "title": "SetPosture",
      "type": "object"
    },
    "SetWebSearch": {
      "description": "Turn the model provider's built-in web search on or off for this session. Applies from\nthe next turn. Its searches run inside the provider and are not approved one by one.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "SetWebSearch",
      "type": "object"
    },
    "SettingsAck": {
      "description": "Acknowledgement of ``set_model`` / ``set_posture`` with the value the agent now holds:\nthe new one when ``ok``, the unchanged one when it refused. The bridge copies it into the\nsession list, so the list never shows a setting the agent refused.",
      "properties": {
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "setting": {
          "enum": [
            "model",
            "posture",
            "web_search"
          ],
          "title": "Setting",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelChoice-Output"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "posture": {
          "anyOf": [
            {
              "enum": [
                "ask_everything",
                "trust_safe",
                "auto",
                "never_ask"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posture"
        },
        "web_search": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Web Search"
        }
      },
      "required": [
        "ok",
        "detail",
        "setting",
        "model",
        "posture",
        "web_search"
      ],
      "title": "SettingsAck",
      "type": "object"
    },
    "SteerMessage": {
      "description": "Guidance for the turn in progress, injected before the agent's next model call.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "SteerMessage",
      "type": "object"
    },
    "WebSource": {
      "description": "One page the provider's web search used for a reply.",
      "properties": {
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "WebSource",
      "type": "object"
    },
    "WorkflowStreamState": {
      "description": "Serializable snapshot of stream state for continue-as-new.\n\n.. warning::\n    This class is experimental and may change in future versions.\n\nThe containing workflow input must type the field as\n``WorkflowStreamState | None``, not ``Any``, so the default data converter\ncan reconstruct the dataclass from JSON.\n\nLog items use the wire representation for serialization stability.",
      "properties": {
        "log": {
          "items": {
            "$ref": "#/$defs/_WorkflowStreamWireItem"
          },
          "title": "Log",
          "type": "array"
        },
        "base_offset": {
          "default": 0,
          "title": "Base Offset",
          "type": "integer"
        },
        "publishers": {
          "additionalProperties": {
            "$ref": "#/$defs/PublisherState"
          },
          "title": "Publishers",
          "type": "object"
        }
      },
      "title": "WorkflowStreamState",
      "type": "object"
    },
    "WorkspaceState": {
      "additionalProperties": false,
      "description": "What the workspace's terminal did last, and the branch it is on.\n\nEvery field has a default: a run restores this from CarriedState JSON written by an\nolder version.",
      "properties": {
        "branch": {
          "default": "",
          "title": "Branch",
          "type": "string"
        },
        "last_command": {
          "default": "",
          "title": "Last Command",
          "type": "string"
        },
        "last_exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Exit Code"
        },
        "commands_run": {
          "default": 0,
          "title": "Commands Run",
          "type": "integer"
        }
      },
      "required": [
        "branch",
        "last_command",
        "last_exit_code",
        "commands_run"
      ],
      "title": "WorkspaceState",
      "type": "object"
    },
    "_WorkflowStreamWireItem": {
      "description": "Wire representation of a WorkflowStreamItem (base64 of serialized Payload).",
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "data": {
          "title": "Data",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "topic",
        "data"
